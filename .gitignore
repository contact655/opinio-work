# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
# ローカルの build / start 専用（next.config.mjs の distDir）。Vercel では使わない
/.next-prod/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Seed script output
scripts/.seed-sample-data-output.txt
scripts/.seed-external-links-output.txt

# Claude Code Desktop が自動生成する worktree ディレクトリ
.claude/worktrees/

# Backups (DB data exports, not for version control)
docs/backups/

# Supabase CLI cache (auto-generated)
supabase/.temp/

# Lazyweb (デザイン調査の作業用ディレクトリ。スクリーンショット等で数十MBになる)
.lazyweb/

# 作業前ダンプ（scripts/dump-tables.sh）。**本番データなのでコミットしない**
.dumps/

# 検証用の一時HTML（public/ に置いて document.cookie を書くやつ）。
# ⚠️ **本物のセッショントークンが入る。** コミットすると opinio.jp から
#    ログイン済みセッションを配るページが配信される。
# ⚠️ 使い終わったらファイル自体を消すこと（この無視設定は保険）。
#    経緯は CLAUDE.md「② ブラウザで確かめる場合: public/ に一時HTMLを置いて…」
public/_tmp_*
